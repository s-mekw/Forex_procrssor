# InfluxDB Configuration
# Copy this file to .env and fill in your actual values

# Required: InfluxDB connection settings
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=your-organization-name
INFLUXDB_BUCKET=forex-data

# Optional: Server URL (default: http://localhost:8086)
INFLUXDB_URL=http://localhost:8086

# Optional: Connection timeout in milliseconds (default: 10000)
INFLUXDB_TIMEOUT=10000

# Optional: Whether to verify SSL certificates (default: true)
# Set to false for self-signed certificates in development
INFLUXDB_VERIFY_SSL=true

# Note: Never commit the actual .env file with real credentials to version control
# Make sure .env is in your .gitignore file